# Postgres via the session-mode pooler (port 5432). Used by Drizzle and drizzle-kit.
# Replace every [PLACEHOLDER] value.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase client. The publishable key is safe to expose in the browser.
# Never put a secret/service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[YOUR-PUBLISHABLE-KEY]

# Integration database tests (T03). Use a development database and test-only
# Supabase Auth accounts. `pnpm test:db` refuses to run unless ALLOW_DB_TESTS=1
# and NODE_ENV is not production. The accounts are created on first run and are
# never deleted by the test suite. Never commit real credentials.
ALLOW_DB_TESTS=0
TEST_USER_A_EMAIL=test-user-a@[TEST-DOMAIN]
TEST_USER_A_PASSWORD=[TEST-USER-A-PASSWORD]
TEST_USER_B_EMAIL=test-user-b@[TEST-DOMAIN]
TEST_USER_B_PASSWORD=[TEST-USER-B-PASSWORD]
